# Required in production. A random local development key is generated if blank.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: enables Gemini-backed writing. Without a key, safe local drafts are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: enables live job search via Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# SQLite database path; created automatically.
DATABASE_PATH=instance/jobs.db

# Set true only for local development diagnostics.
FLASK_DEBUG=false
LOG_LEVEL=INFO
